{
  "name": "prompt-optimizer",
  "version": "1.0.0",
  "description": "Static DeepSeek Harness (DSH) plugin: an ✨ optimize-prompt button in the composer tool row. Context-aware LLM rewriting with model fallback and visible errors.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "harness",
    "cordis",
    "plugin",
    "llm",
    "prompt-engineering",
    "prompt-optimizer"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0"
  }
}
